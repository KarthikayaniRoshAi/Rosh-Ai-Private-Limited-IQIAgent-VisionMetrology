# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# App Runtime Logs (Keeps Git clean; doesn't affect UI logs!)
*.log
logs/
uvicorn*.log

# IQI Metrology Generated Output & Training Uploads
# Ignore uploaded dynamic PDFs and generated YAML/JSON outputs
visual_metrology/data/train/*
!visual_metrology/data/train/.gitkeep
visual_metrology/data/output/*
!visual_metrology/data/output/.gitkeep
/iqi_storage/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Testing & linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & OS files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Database (if used)
*.db
*.sqlite3